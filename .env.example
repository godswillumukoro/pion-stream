# pion-stream configuration
# =========================
# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# All variables are optional — defaults are used when unset.

# HTTP server port (default: 80)
PORT=80

# UDP port range for WebRTC ICE candidates (default: 3000-4000)
UDP_PORT_MIN=3000
UDP_PORT_MAX=4000

# Public IP of the server. Set this if the server is behind NAT
# and the public IP differs from the interface address.
# Leave empty to auto-detect.
PUBLIC_IP=

# STUN server for NAT traversal (default: Google public STUN)
STUN_SERVER=stun:stun.l.google.com:19302

# Optional bearer token for WHIP publish authentication.
# If set, OBS must include this in the stream key field or as
# an Authorization: Bearer <key> header.
# Leave empty for no authentication.
STREAM_KEY=
